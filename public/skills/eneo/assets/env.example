# Copy this file to .env in your project folder and fill in the values.
# Keep .env out of version control: add ".env" to .gitignore.

# The Eneo installation. No trailing slash and no /api/v1.
ENEO_BASE_URL=https://eneo-modules.sundsvall.dev

# Created in Eneo under the profile menu -> "Mina API-nycklar". Shown only once.
ENEO_API_KEY=

# Optional until you have an assistant: the UUID of the assistant to call.
ENEO_ASSISTANT_ID=
